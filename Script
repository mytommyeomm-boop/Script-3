--[[ ============================================================
    AUTO DODGE V6 — FINAL
    ------------------------------------------------------------
    • Close-range fixed: Margin 0.12 (mid-window) + DASH_WINDOW 0.22
    • Per-punch cooldown bypass (combo ต่อเนื่อง)
    • Priority chain: Perfect flag > NeededDirection > Predictive
    • Fast retry 8ms + RenderStepped (ไม่รอ Heartbeat)
    • Feint Intercept (ก้างทาง) — armed 0.85s หลัง feint
    • GUI 2 ปุ่มแยก: toggle + gear (ไม่หาย)
    ============================================================ ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")
local Players           = game:GetService("Players")
local UIS               = game:GetService("UserInputService")
local TS                = game:GetService("TweenService")

local LP        = Players.LocalPlayer
local PGui      = LP:WaitForChild("PlayerGui")
local ForceDash = ReplicatedStorage:WaitForChild("Events"):WaitForChild("ForceDash")
local Styles    = require(ReplicatedStorage.Modules:WaitForChild("Styles"))

-- ==========================================================
--  CONFIG
-- ==========================================================
local CFG = {
    Enabled             = false,
    Margin              = 0.12,      -- mid-window
    MinCooldown         = 0.015,     -- rapid punch
    StrictSide          = true,
    OnlyWhenTargeted    = true,
    AntiFeint           = true,
    FeintIntercept      = true,
    FeintArmWindow      = 0.85,
    LatencyCompensation = true,
    ManualPingOffset    = nil,
    Debug               = false,
}

local DASH_WINDOW = 0.22             -- perfect window (server ~0.22s)

-- ==========================================================
--  STATE
-- ==========================================================
local lastDodgeTime   = 0
local lastDodgePunchId = nil
local opponent        = nil
local oppConns        = {}
local myConns         = {}
local alternateSide   = "Left"
local punchStates     = {}
local pendingDodge    = nil
local feint = {
    count = 0, lastAt = 0, armedUntil = 0, armedDirection = nil,
}
local stats = { dodges = 0, perfects = 0, intercepts = 0, predictives = 0 }

local function log(...)
    if CFG.Debug then print("[Dodge]", ...) end
end

-- ==========================================================
--  HELPERS
-- ==========================================================
local function getState(n)
    local s = Workspace:FindFirstChild("States")
    return s and s:FindFirstChild(n)
end
local function getMyCD()  local s = getState(LP.Name); return s and s:FindFirstChild("CharacterData") end
local function getMyOcc() local s = getState(LP.Name); return s and s:FindFirstChild("Occupied") end

local function canDash()
    local c = LP.Character
    if not (c and c.PrimaryPart) then return false end
    local o = getMyOcc(); if not o then return false end
    if o.Dashing.Value then return false end
    local d = getMyCD(); if not d then return false end
    if d.Stunned.Value or d.Cutscene.Value then return false end
    if d.Stamina.Value <= 1 then return false end
    if c:GetAttribute("RiceballChanneling") then return false end
    if c:GetAttribute("NoDash") then return false end
    return true
end

local function getNeededDirection()
    local c = LP.Character; if not c then return nil end
    local dir = c:GetAttribute("NeededDirection")
    if dir == "Left" or dir == "Right" or dir == "Forward" or dir == "Backward" then
        return dir
    end
    return nil
end

local function computeSideDirection()
    local c = LP.Character
    if not (c and c.PrimaryPart) then return alternateSide end
    local o = getMyOcc()
    local locked = o and o.LockedOn.Value
    if locked and locked.PrimaryPart then
        local away = (c.PrimaryPart.Position - locked.PrimaryPart.Position) * Vector3.new(1,0,1)
        if away.Magnitude > 0.1 then
            away = away.Unit
            local side = Vector3.new(away.Z, 0, -away.X)
            local look = c.PrimaryPart.CFrame.LookVector * Vector3.new(1,0,1)
            if look.Magnitude > 0.1 then
                return side:Dot(look.Unit) > 0 and "Right" or "Left"
            end
        end
    end
    return alternateSide
end

local function isOppFeinting(opp)
    if not opp then return false end
    return opp:GetAttribute("IsFeinting") == true
        or opp:GetAttribute("LocalIsFeinting") == true
end

local function getOppHitDirection(opp)
    if not opp then return nil end
    local os = getState(opp.Name); if not os then return nil end
    local pd = os:FindFirstChild("PlayerData")
    local occ = os:FindFirstChild("Occupied")
    if not (pd and occ) then return nil end
    local sv = pd:FindFirstChild("Style"); if not sv then return nil end
    local style = Styles[sv.Value]; if not style then return nil end

    local isHeavy = opp:GetAttribute("IsHeavy") == true
    local comboId = 1
    local cc = occ:FindFirstChild("CurrentCombo"); if cc then comboId = cc.Value end
    local punchNum = 1
    local cp = occ:FindFirstChild("CurrentPunch"); if cp then punchNum = cp.Value end

    if isHeavy then
        local ha = style.HeavyAttacks
        if ha and ha[punchNum] and ha[punchNum].HitInfo then
            return ha[punchNum].HitInfo.Direction
        end
    else
        local combo = style.Combos[comboId]
        if combo then
            local hit = combo[punchNum]
            if hit and hit.HitInfo and hit.HitInfo.Direction then
                return hit.HitInfo.Direction
            end
            if combo.DefaultPunchInfo and combo.DefaultPunchInfo.HitInfo then
                return combo.DefaultPunchInfo.HitInfo.Direction
            end
        end
    end
    return nil
end

local function hitDirToDodge(hitDir)
    if not hitDir then return nil end
    if hitDir == "Left" or hitDir == "BodyLeft" then return "Right"
    elseif hitDir == "Right" or hitDir == "BodyRight" then return "Left"
    elseif hitDir == "Forward" or hitDir == "BodyForward" then return alternateSide
    end
    return nil
end

local function getPingOffset()
    if CFG.ManualPingOffset then return CFG.ManualPingOffset end
    if not CFG.LatencyCompensation then return 0 end
    return math.clamp((LP:GetNetworkPing() or 0) / 2, 0.02, 0.10)
end

-- ==========================================================
--  DASH — per-punch bypass
-- ==========================================================
local function executeDash(dir, isIntercept, isPredictive)
    lastDodgeTime = Workspace:GetServerTimeNow()
    ForceDash:Fire({ Direction = dir, IgnoreStun = false })
    if dir == "Left"  then alternateSide = "Right"
    elseif dir == "Right" then alternateSide = "Left" end
    stats.dodges = stats.dodges + 1
    if isIntercept  then stats.intercepts  = stats.intercepts + 1  end
    if isPredictive then stats.predictives = stats.predictives + 1 end
    log("DASH →", dir,
        isIntercept and "(INTERCEPT)" or isPredictive and "(PRED)" or "")

    task.spawn(function()
        local deadline = lastDodgeTime + 0.2
        while Workspace:GetServerTimeNow() < deadline do
            local c = LP.Character
            if c and c:GetAttribute("Perfect") then
                stats.perfects = stats.perfects + 1
                return
            end
            task.wait(0.01)
        end
    end)
    return true
end

local function tryDash(dir, isIntercept, punchId, isPredictive)
    if not dir then return false end
    local now = Workspace:GetServerTimeNow()

    if not canDash() then
        pendingDodge = {
            dir = dir, expires = now + 0.4,
            intercept = isIntercept, punchId = punchId, predictive = isPredictive,
        }
        return false
    end

    -- per-punch cooldown bypass
    local isNewPunch = punchId and punchId ~= lastDodgePunchId
    if not isNewPunch and now - lastDodgeTime < CFG.MinCooldown then
        pendingDodge = {
            dir = dir, expires = now + 0.4,
            intercept = isIntercept, punchId = punchId, predictive = isPredictive,
        }
        return false
    end

    lastDodgePunchId = punchId
    return executeDash(dir, isIntercept, isPredictive)
end

-- ==========================================================
--  FEINT INTERCEPT (ก้างทาง)
-- ==========================================================
local function armFeintIntercept(opp)
    local guess = hitDirToDodge(getOppHitDirection(opp))
    feint.count = feint.count + 1
    feint.lastAt = Workspace:GetServerTimeNow()
    feint.armedUntil = feint.lastAt + CFG.FeintArmWindow
    feint.armedDirection = guess
    pendingDodge = nil
    if opponent then
        local cpId = opponent:GetAttribute("CurrentPunchId") or 0
        if punchStates[cpId] then punchStates[cpId].cancelled = true end
    end
    log("FEINT armed →", guess or "?", "win", CFG.FeintArmWindow)
end

local function isInterceptArmed()
    return CFG.FeintIntercept and Workspace:GetServerTimeNow() < feint.armedUntil
end

local function tryIntercept()
    if not isInterceptArmed() then return end
    if not opponent then return end

    local cpId = opponent:GetAttribute("CurrentPunchId") or 0
    local state = punchStates[cpId]
    if state and state.dodged then return end

    local nd = getNeededDirection()
    if nd then
        if tryDash(nd, true, cpId) then
            punchStates[cpId] = punchStates[cpId] or { startTime = Workspace:GetServerTimeNow() }
            punchStates[cpId].dodged = true
            feint.armedUntil = 0
        end
        return
    end

    local landTime = opponent:GetAttribute("LandTime")
    if landTime then
        local now    = Workspace:GetServerTimeNow()
        local offset = getPingOffset()
        local left   = landTime - now
        if left <= (offset + CFG.Margin) and left >= -0.08 then
            local dir = feint.armedDirection or computeSideDirection()
            if tryDash(dir, true, cpId) then
                punchStates[cpId] = punchStates[cpId] or {}
                punchStates[cpId].dodged = true
                feint.armedUntil = 0
            end
        end
    end
end

-- ==========================================================
--  PUNCH TRACKING
-- ==========================================================
local function onPunch(opp, forceHeavy)
    if not CFG.Enabled then return end
    if CFG.OnlyWhenTargeted then
        local os  = getState(opp.Name)
        local occ = os and os:FindFirstChild("Occupied")
        local tgt = occ and occ:FindFirstChild("LockedOn")
        if tgt and tgt.Value ~= LP.Character then return end
    end
    local id = opp:GetAttribute("CurrentPunchId") or 0
    punchStates[id] = {
        dodged    = false,
        cancelled = false,
        startTime = Workspace:GetServerTimeNow(),
        isHeavy   = forceHeavy or (opp:GetAttribute("IsHeavy") == true),
    }
    log("punch id=", id, "heavy=", tostring(punchStates[id].isHeavy))

    local now = Workspace:GetServerTimeNow()
    for k, v in pairs(punchStates) do
        if k ~= id and (now - v.startTime) > 3 then punchStates[k] = nil end
    end

    if isInterceptArmed() then tryIntercept() end
end

-- ==========================================================
--  MAIN DODGE LOGIC — Priority Chain
-- ==========================================================
local function tryDodgeForCurrentPunch()
    if not CFG.Enabled then return end
    if not opponent then return end
    if CFG.AntiFeint and isOppFeinting(opponent) then return end

    if isInterceptArmed() then
        tryIntercept()
        return
    end

    local cpId = opponent:GetAttribute("CurrentPunchId") or 0
    local state = punchStates[cpId]
    if state and (state.dodged or state.cancelled) then return end

    local char = LP.Character
    if not char then return end

    -- ═══ P1: Perfect flag SET ═══
    if char:GetAttribute("Perfect") then
        local nd = getNeededDirection()
        if nd and tryDash(nd, false, cpId) then
            punchStates[cpId] = punchStates[cpId] or { startTime = Workspace:GetServerTimeNow() }
            punchStates[cpId].dodged = true
            log("★ PERFECT (flag) →", nd)
        end
        return
    end

    -- ═══ P2: NeededDirection set ═══
    local nd = getNeededDirection()
    if nd then
        if tryDash(nd, false, cpId) then
            punchStates[cpId] = punchStates[cpId] or { startTime = Workspace:GetServerTimeNow() }
            punchStates[cpId].dodged = true
            log("★ ND instant →", nd)
        end
        return
    end

    -- ═══ P3: Predictive (LandTime mid-window + HitInfo) ═══
    local landTime = opponent:GetAttribute("LandTime")
    if landTime then
        local now    = Workspace:GetServerTimeNow()
        local offset = getPingOffset()
        local windowStart = landTime - DASH_WINDOW - offset
        if now >= windowStart and now <= (landTime - 0.02) then
            local d = hitDirToDodge(getOppHitDirection(opponent)) or computeSideDirection()
            if CFG.StrictSide and (d == "Forward" or d == "Backward") then
                d = computeSideDirection()
            end
            if tryDash(d, false, cpId, true) then
                punchStates[cpId] = punchStates[cpId] or { startTime = now }
                punchStates[cpId].dodged = true
                log("★ Predictive →", d)
            end
        end
    end
end

-- ==========================================================
--  FAST RETRY (8ms) — pending queue
-- ==========================================================
task.spawn(function()
    while true do
        task.wait(0.008)
        if not CFG.Enabled then continue end
        if pendingDodge then
            local now = Workspace:GetServerTimeNow()
            if now > pendingDodge.expires then
                pendingDodge = nil
            elseif canDash() then
                local p = pendingDodge
                pendingDodge = nil
                executeDash(p.dir, p.intercept, p.predictive)
            end
        end
    end
end)

-- ==========================================================
--  LOOPS — RenderStepped + Heartbeat สำรอง
-- ==========================================================
RunService.RenderStepped:Connect(function()
    if not CFG.Enabled then return end
    tryDodgeForCurrentPunch()
end)

RunService.Heartbeat:Connect(function()
    if not CFG.Enabled then return end
    tryDodgeForCurrentPunch()
end)

-- ==========================================================
--  MY CHARACTER — NeededDirection instant
-- ==========================================================
local function bindMyChar(char)
    for _, c in ipairs(myConns) do c:Disconnect() end
    table.clear(myConns)
    if not char then return end

    table.insert(myConns, char:GetAttributeChangedSignal("NeededDirection"):Connect(function()
        if not CFG.Enabled then return end
        local nd = getNeededDirection()
        if not nd then return end
        if not opponent then return end
        if CFG.AntiFeint and isOppFeinting(opponent) then return end

        local cpId = opponent:GetAttribute("CurrentPunchId") or 0
        local state = punchStates[cpId]
        if state and state.dodged then return end

        local isInt = isInterceptArmed()
        if tryDash(nd, isInt, cpId) then
            punchStates[cpId] = punchStates[cpId] or {}
            punchStates[cpId].dodged = true
            if isInt then feint.armedUntil = 0 end
            log("instant ND →", nd, isInt and "(INT)" or "")
        end
    end))
end

-- ==========================================================
--  OPPONENT BINDING
-- ==========================================================
local function unbindOpp()
    for _, c in ipairs(oppConns) do c:Disconnect() end
    table.clear(oppConns)
    opponent = nil
end

local function bindOpp(oppChar)
    unbindOpp()
    if not oppChar then return end
    opponent = oppChar
    log("bound:", oppChar.Name)

    local lastId = oppChar:GetAttribute("CurrentPunchId") or 0
    table.insert(oppConns, oppChar:GetAttributeChangedSignal("CurrentPunchId"):Connect(function()
        local nid = oppChar:GetAttribute("CurrentPunchId") or 0
        if nid ~= lastId then
            lastId = nid
            onPunch(oppChar, nil)
        end
    end))

    local wp = oppChar:GetAttribute("Punching") or false
    table.insert(oppConns, oppChar:GetAttributeChangedSignal("Punching"):Connect(function()
        local n = oppChar:GetAttribute("Punching") or false
        if n and not wp then onPunch(oppChar, nil) end
        wp = n
    end))

    local wh = oppChar:GetAttribute("HeavyPunching") or false
    table.insert(oppConns, oppChar:GetAttributeChangedSignal("HeavyPunching"):Connect(function()
        local n = oppChar:GetAttribute("HeavyPunching") or false
        if n and not wh then onPunch(oppChar, true) end
        wh = n
    end))

    local wf = oppChar:GetAttribute("IsFeinting") or false
    table.insert(oppConns, oppChar:GetAttributeChangedSignal("IsFeinting"):Connect(function()
        local n = oppChar:GetAttribute("IsFeinting") or false
        if n and not wf then
            if CFG.AntiFeint or CFG.FeintIntercept then
                armFeintIntercept(oppChar)
            end
        end
        wf = n
    end))
end

local function watchOpp()
    local cd = getMyCD(); if not cd then return end
    local oppVal = cd:FindFirstChild("Opponent"); if not oppVal then return end
    bindOpp(oppVal.Value)
    table.insert(oppConns, oppVal.Changed:Connect(bindOpp))
end

task.spawn(function()
    while not getMyCD() do task.wait(0.2) end
    watchOpp()
    if LP.Character then bindMyChar(LP.Character) end
end)
LP.CharacterAdded:Connect(function(c)
    task.wait(1)
    watchOpp()
    bindMyChar(c)
end)

