local catchState = {
    running = false,
    lastThrow = 0,
    history = {},
    targetLock = nil,
    targetLockUntil = 0,
    settings = {
        Interval    = 0.05,
        MaxAngle    = 180,
        MaxRange    = 500,
        PreferTier  = "auto",
        SkipHeld    = false,
        Aggressive  = true,
        LockTarget  = true,
        AutoEnable  = true,
        RotateTier  = true,
    },
}

local function readBag()
    local c = {}
    for _, t in TierOrder do c[t] = 0 end
    local s = LocalPlayer:GetAttribute("CatchBalls")
    if type(s) ~= "string" then return c end
    local i = 1
    for n in string.gmatch(s, "[^,]+") do
        if TierOrder[i] then c[TierOrder[i]] = tonumber(n) or 0 end
        i += 1
    end
    return c
end

local function pickTier(counts)
    if catchState.settings.PreferTier ~= "auto"
        and (counts[catchState.settings.PreferTier] or 0) > 0 then
        return catchState.settings.PreferTier
    end
    for i = #TierOrder, 1, -1 do
        if (counts[TierOrder[i]] or 0) > 0 then
            return TierOrder[i]
        end
    end
    return nil
end

local function catchPlayerReady()
    if LocalPlayer:GetAttribute("CatchOn") ~= true then
        if catchState.settings.AutoEnable then
            pcall(function() LocalPlayer:SetAttribute("CatchOn", true) end)
        end
        if LocalPlayer:GetAttribute("CatchOn") ~= true then
            return false, "โหมดจับปิด"
        end
    end
    if LocalPlayer:GetAttribute(RiderAttr) == true then return false, "ขี่สัตว์" end
    if LocalPlayer:GetAttribute("IslandVisitState") ~= nil then return false, "เยี่ยมเกาะ" end
    local ch = LocalPlayer.Character
    local h  = ch and ch:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false, "ตาย" end
    if not ch:FindFirstChild("HumanoidRootPart") then return false, "ไม่มี RootPart" end
    return true
end

local function catchableV2(m)
    if not m:IsA("Model") or not m.PrimaryPart then return false end
    if not m:IsDescendantOf(Workspace) then return false end
    if m:GetAttribute("CatchGhost") == true then return false end
    if m:GetAttribute("RoundHidden") == true then return false end
    if type(m:GetAttribute("SlotId")) ~= "string" then return false end
    if catchState.settings.SkipHeld then
        local now = Workspace:GetServerTimeNow()
        local h = m:GetAttribute("CatchHeldUntil")
        if type(h) == "number" and now < h then return false end
        local st = m:GetAttribute("BossStunUntil")
        if type(st) == "number" and now < st then return false end
    end
    return true
end

local function findTargetV2(cam, myPos)
    if catchState.settings.LockTarget
        and catchState.targetLock
        and os.clock() < catchState.targetLockUntil
        and catchState.targetLock.Parent
        and catchableV2(catchState.targetLock) then
        return catchState.targetLock
    end

    local camP = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    local best, bestScore = nil, math.huge
    for _, m in CollectionService:GetTagged(Creatures.CreatureTag) do
        if not catchableV2(m) then continue end
        local pos = m:GetPivot().Position
        local d   = (pos - myPos).Magnitude
        if d > catchState.settings.MaxRange then continue end
        local u = (pos - camP).Unit
        local a = math.deg(math.acos(math.clamp(look:Dot(u), -1, 1)))
        if a > catchState.settings.MaxAngle then continue end
        local s = a * 0.5 + d * 0.1
        if s < bestScore then bestScore, best = s, m end
    end
    if best and catchState.settings.LockTarget then
        catchState.targetLock = best
        catchState.targetLockUntil = os.clock() + 3
    end
    return best
end

local function fireCatch(target, tier)
    if not CatchThrowRemote then return false end
    local ok = pcall(function()
        CatchThrowRemote:FireServer({
            tier   = tier,
            target = target:GetAttribute("SlotId"),
            aim    = target:GetPivot().Position,
        })
    end)
    if ok then
        stats.caught += 1
        table.insert(catchState.history, os.clock())
        return true
    end
    stats.failed += 1
    return false
end

local function catchLoopV2()
    log("AutoCatch v2 (Aggressive): เริ่ม")
    local lastTierRotate = 0
    local tierIdx = #TierOrder

    while catchState.running do
        task.wait(0.01)
        local ready, reason = catchPlayerReady()
        if not ready then stats.lastReason = reason; continue end
        if os.clock() - catchState.lastThrow < catchState.settings.Interval then continue end

        local bag = readBag()
        local tier = pickTier(bag)

        if catchState.settings.RotateTier and tier then
            if os.clock() - lastTierRotate > 0.5 then
                lastTierRotate = os.clock()
                tierIdx = tierIdx - 1
                if tierIdx < 1 then tierIdx = #TierOrder end
                if (bag[TierOrder[tierIdx]] or 0) > 0 then
                    tier = TierOrder[tierIdx]
                end
            end
        end

        if not tier then stats.lastReason = "ไม่มีลูกบอล"; continue end

        local cam = Workspace.CurrentCamera
        local ch  = LocalPlayer.Character
        local rt  = ch and ch:FindFirstChild("HumanoidRootPart")
        if not cam or not rt then continue end

        local t = findTargetV2(cam, rt.Position)
        if not t then stats.lastReason = "ไม่เจอเป้า"; continue end

        if fireCatch(t, tier) then
            catchState.lastThrow = os.clock()
            stats.lastReason = "ยิง"
        else
            stats.lastReason = "rate limit (server)"
        end
    end
    log("AutoCatch v2: หยุด")
end

