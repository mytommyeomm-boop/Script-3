-- ============================================================
-- Base helpers
-- ============================================================
local function getMyBase()
    local map = workspace:FindFirstChild("Map")
    local bases = map and map:FindFirstChild("Bases")
    if not bases then return nil end
    for _, b in ipairs(bases:GetChildren()) do
        if b:GetAttribute("OwnerUserId") == LP.UserId then return b end
    end
    return nil
end

local function inMyBase(inst)
    local base = getMyBase()
    if not base or not inst then return false end
    local cur = inst
    while cur and cur ~= workspace do
        if cur == base then return true end
        cur = cur.Parent
    end
    return false
end

local function getChar()
    local c = LP.Character
    return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function freeHands()
    local char = getChar()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and char:FindFirstChildOfClass("Tool") then
        pcall(function() hum:UnequipTools() end)
    end
end

local function walkTo(pos, timeout)
    if not Config.Walk then return false end
    local char, root, hum = getChar()
    if not root or not hum then return false end
    timeout = timeout or 8
    local t0 = tick()
    while tick() - t0 < timeout do
        if not root.Parent then return false end
        if (root.Position - pos).Magnitude <= 4 then return true end
        pcall(function() hum:MoveTo(pos) end)
        task.wait(0.1)
    end
    return false
end

-- Ray visual
local rayPart
local function showRay(from, to, color)
    if not Config.ShowRay then
        if rayPart then rayPart.Transparency = 1 end
        return
    end
    if not rayPart or not rayPart.Parent then
        rayPart = Instance.new("Part")
        rayPart.Name = "AutoFarmRay"
        rayPart.Anchored = true
        rayPart.CanCollide = false
        rayPart.CanQuery = false
        rayPart.CanTouch = false
        rayPart.CastShadow = false
        rayPart.Material = Enum.Material.Neon
        rayPart.Size = Vector3.new(0.1, 0.1, 1)
        rayPart.Parent = workspace
    end
    rayPart.Color = color or Color3.fromRGB(0, 255, 140)
    local dir = to - from
    local len = dir.Magnitude
    if len < 0.2 then rayPart.Transparency = 1 return end
    local mid = from + dir * 0.5
    rayPart.CFrame = CFrame.lookAt(mid, mid + dir.Unit)
    rayPart.Size = Vector3.new(0.1, 0.1, len)
    rayPart.Transparency = 0.55
end

-- ============================================================
-- HARVEST
-- ============================================================
local function findPrompt(fruit)
    for _, d in ipairs(fruit:GetDescendants()) do
        if d.Name == "Harvest" and d:IsA("ProximityPrompt") then return d end
    end
end

local function canHarvest(fruit)
    if not fruit or not fruit.Parent then return false end
    if fruit:GetAttribute("CatchBy") then return false end
    local part = fruit:FindFirstChildWhichIsA("BasePart", true)
    if not part then return false end
    local prompt = findPrompt(fruit)
    if not prompt or not prompt.Enabled then return false end

    local unripe = prompt:GetAttribute("Unripe")
    local mine = inMyBase(fruit)

    if unripe then
        if not (Config.AutoPurge and isPurgeNow()) then return false end
        if mine then return false end
    else
        if not mine and not (Config.AutoPurge and isPurgeNow()) then return false end
    end
    return true, prompt, part
end

local function isPurgeNow()
    local ok, cfg = pcall(require, ReplicatedStorage.Shared:WaitForChild("WorldClock"))
    if not ok then return false end
    local ok2, r = pcall(cfg.IsPurgeNow)
    return ok2 and r or false
end

local function findHarvestProximity()
    local _, root = getChar()
    if not root then return end
    local best, bestD = nil, Config.HarvestRange
    for _, fruit in ipairs(CollectionService:GetTagged("DurianFruit")) do
        local ok, prompt, part = canHarvest(fruit)
        if ok then
            local d = (part.Position - root.Position).Magnitude
            if d < bestD then
                best = { fruit=fruit, prompt=prompt, part=part, dist=d }
                bestD = d
            end
        end
    end
    return best
end

local function findHarvestAim()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X * 0.5, vp.Y * 0.5)

    local parts = {}
    for _, fruit in ipairs(CollectionService:GetTagged("DurianFruit")) do
        if canHarvest(fruit) then
            local p = fruit:FindFirstChildWhichIsA("BasePart", true)
            if p then table.insert(parts, p) end
        end
    end
    if #parts == 0 then return end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = parts
    local res = workspace:Raycast(ray.Origin, ray.Direction * 250, params)
    if not res then return end

    local inst = res.Instance
    while inst and inst ~= workspace do
        if CollectionService:HasTag(inst, "DurianFruit") then
            local ok, prompt, part = canHarvest(inst)
            if ok then
                return { fruit=inst, prompt=prompt, part=part, dist=res.Distance }
            end
        end
        inst = inst.Parent
    end
end

local function fireHarvest(target)
    local char = getChar()
    if not char then return false end
    freeHands()
    task.wait(0.05)

    local ok = pcall(function() HarvestRemote:FireServer(target.prompt) end)
    if not ok then return false end

    -- รอ CatchStart
    local t0 = tick()
    local started = false
    while tick() - t0 < 3 do
        if char:GetAttribute("CatchStart") then started = true break end
        if not char.Parent then return false end
        task.wait(0.05)
    end
    if not started then return false end

    -- รอจนจบ
    t0 = tick()
    while char.Parent and char:GetAttribute("CatchStart") and (tick() - t0) < 10 do
        task.wait(0.1)
    end
    if not char.Parent then return false end
    if char:GetAttribute("CatchStart") then
        if CatchCancel then pcall(function() CatchCancel:FireServer() end) end
        return false
    end
    return true
end

local function tryHarvest()
    local char, root = getChar()
    if not char or not root then Status.Harvest = "NO CHAR" return false end
    if char:GetAttribute("CatchStart") then Status.Harvest = "CATCHING..." return true end

    Status.Harvest = "SEARCHING"
    local target = Config.HarvestMode == "Aim" and findHarvestAim() or findHarvestProximity()
    if not target then Status.Harvest = "NO TARGET" return false end

    showRay(root.Position + Vector3.new(0, 2, 0), target.part.Position, Color3.fromRGB(0, 255, 140))
    Status.Harvest = "HARVESTING"
    local ok = fireHarvest(target)
    if ok then
        Stats.Harvested = Stats.Harvested + 1
        Status.Harvest = "DONE ✓"
    else
        Status.Harvest = "FAILED"
    end
    return true
end

-- ============================================================
-- WATER
-- ============================================================
local function findWateringCan()
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    for _, c in ipairs({ char, bp }) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("GearId") == "WateringCan" then
                    return t
                end
            end
        end
    end
end

local function findWell()
    local base = getMyBase()
    if not base then return end
    for _, name in ipairs({ "Well", "WaterWell", "WaterWellModel", "BuyPad_Well" }) do
        for _, d in ipairs(base:GetDescendants()) do
            if d.Name == name and d:IsA("BasePart") then return d.Position end
        end
    end
    for _, d in ipairs(base:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("well") then
            return d.Position
        end
    end
end

local function findWaterTarget()
    local _, root = getChar()
    if not root then return end

    local base = getMyBase()
    if not base then return end

    local best, bestD = nil, Config.WaterRange
    for _, d in ipairs(base:GetDescendants()) do
        if d.Name == "PlantSpot" and d:IsA("BasePart") and not wateredSet[d] then
            local parent = d.Parent
            if parent and (parent:FindFirstChild("Tree") or parent:FindFirstChild("Seed")) then
                local dist = (d.Position - root.Position).Magnitude
                if dist < bestD then
                    best = d
                    bestD = dist
                end
            end
        end
    end
    return best, bestD
end

local function tryWater()
    local char, root = getChar()
    if not char or not root then Status.Water = "NO CHAR" return false end

    -- ต้องมี watering can
    local can = findWateringCan()
    if not can then Status.Water = "NO CAN" return false end

    -- ถือ can
    local curTool = char:FindFirstChildOfClass("Tool")
    if curTool ~= can then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:EquipTool(can) end)
            task.wait(0.1)
        end
    end

    -- น้ำหมด → เติม
    local uses = LP:GetAttribute("WaterUses") or 0
    if uses <= 0 then
        local wellPos = findWell()
        if not wellPos then
            Status.Water = "NO WELL FOUND"
            return false
        end
        local dist = (root.Position - wellPos).Magnitude
        if dist > 10 then
            Status.Water = "WALK TO WELL"
            walkTo(wellPos)
            return true
        end
        WaterRemote:FireServer("Water", char:GetPivot().Position)
        Status.Water = "REFILLING"
        task.wait(1.2)
        return true
    end

    -- หาเป้ารดน้ำ
    local target, dist = findWaterTarget()
    if not target then
        Status.Water = "ALL DONE"
        return false
    end

    if dist > 10 then
        Status.Water = "WALKING"
        showRay(root.Position + Vector3.new(0, 2, 0), target.Position, Color3.fromRGB(90, 190, 255))
        walkTo(target.Position)
        return true
    end

    -- รดน้ำ
    local usesBefore = LP:GetAttribute("WaterUses") or 0
    WaterRemote:FireServer("Water", target.Position)
    showRay(root.Position + Vector3.new(0, 2, 0), target.Position, Color3.fromRGB(90, 190, 255))
    task.wait(0.7)
    local usesAfter = LP:GetAttribute("WaterUses") or 0

    wateredSet[target] = true
    if usesAfter < usesBefore then
        Stats.Watered = Stats.Watered + 1
        Status.Water = "WATERED ✓"
    else
        Status.Water = "ALREADY WET"
    end
    return true
end

-- ============================================================
-- SELL
-- ============================================================
local function findBuyer()
    local _, root = getChar()
    if not root then return end

    local best, bestD = nil, Config.SellRange
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") then
            local kind = d:GetAttribute("BuyerKind")
            if kind and (kind == "Durian" or kind == "Rubber" or kind == "Palm") then
                local part = d:FindFirstChild("HumanoidRootPart") or d.PrimaryPart
                if part then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist < bestD then
                        best = { model=d, part=part, kind=kind, dist=dist }
                        bestD = dist
                    end
                end
            end
        end
    end
    return best
end

local function inventoryCount()
    local counts = { durian=0, lump=0, palm=0 }
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    for _, c in ipairs({ char, bp }) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") then
                    if t:GetAttribute("FruitUid") then
                        local fid = t:GetAttribute("FruitId")
                        if isPalm(fid) then
                            counts.palm = counts.palm + 1
                        else
                            counts.durian = counts.durian + 1
                        end
                    elseif t:GetAttribute("ScrapUid") then
                        counts.lump = counts.lump + 1
                    end
                end
            end
        end
    end
    return counts
end

local function trySell()
    local char, root = getChar()
    if not char or not root then Status.Sell = "NO CHAR" return false end

    local inv = inventoryCount()
    local total = inv.durian + inv.lump + inv.palm
    if total == 0 then Status.Sell = "NOTHING" return false end

    if not SellRemote then Status.Sell = "NO REMOTE" return false end

    Status.Sell = "FINDING BUYER"
    local buyer = findBuyer()
    if not buyer then Status.Sell = "NO BUYER" return false end

    -- ถ้าไกล ให้เดินไป
    if buyer.dist > 15 then
        Status.Sell = "WALK TO " .. buyer.kind
        showRay(root.Position + Vector3.new(0, 2, 0), buyer.part.Position, Color3.fromRGB(255, 210, 90))
        walkTo(buyer.part.Position)
        return true
    end

    -- ขายตามชนิดที่มี (ให้ server กรองเอง)
    local mode
    if inv.durian > 0 then
        mode = "All"
    elseif inv.lump > 0 then
        mode = "LumpAll"
    elseif inv.palm > 0 then
        mode = "PalmAll"
    end
    if not mode then return false end

    local ok = pcall(function() SellRemote:FireServer(mode) end)
    if ok then
        Stats.Sold = Stats.Sold + 1
        Status.Sell = "SOLD (" .. mode .. ")"
        task.wait(1.2)
    else
        Status.Sell = "FAILED"
    end
    return true
end

-- ============================================================
-- MAIN LOOP — priority: Sell > Harvest > Water
-- ============================================================
task.spawn(function()
    while true do
        if not Busy then
            local anyOn = Config.Sell or Config.Harvest or Config.Water
            if anyOn and (tick() - LastFire) >= Config.Cooldown then
                local did = false

                if Config.Sell then
                    Busy = true
                    did = trySell()
                    if did then LastFire = tick() end
                    Busy = false
                end

                if not did and Config.Harvest then
                    Busy = true
                    did = tryHarvest()
                    if did then LastFire = tick() end
                    Busy = false
                end

                if not did and Config.Water then
                    Busy = true
                    did = tryWater()
                    if did then LastFire = tick() end
                    Busy = false
                end

                if not did then
                    if Config.Sell    then Status.Sell = Status.Sell ~= "" and Status.Sell or "IDLE" end
                    if Config.Harvest then Status.Harvest = "IDLE" end
                    if Config.Water   then Status.Water = "IDLE" end
                end
            end
        end
        task.wait(0.08)
    end
end)

