local function setRangeFromX(x)
    local ap, as = rangeTrack.AbsolutePosition, rangeTrack.AbsoluteSize
    if as.X <= 0 then return end
    local t = math.clamp((x - ap.X) / as.X, 0, 1)
    local v = math.floor(5 + t * 45)
    Config.HarvestRange = v
    Config.WaterRange = v + 10
    rangeLbl.Text = "Harvest Range: " .. v .. " studs"
    rangeFill.Size = UDim2.new(t, 0, 1, 0)
end

