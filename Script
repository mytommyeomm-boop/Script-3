-- ============================================================
-- Helpers
-- ============================================================
local function getChar()
    local c = LP.Character
    return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function freeHands()
    local char = getChar()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and char:FindFirstChildOfClass("Tool") then
        pcall(function() hum:UnequipTools() end)
        task.wait(0.15)
    end
end

local function isPurgeNow()
    local ok, cfg = pcall(require, ReplicatedStorage.Shared:WaitForChild("WorldClock"))
    if not ok then return false end
    local ok2, r = pcall(cfg.IsPurgeNow)
    return ok2 and r or false
end

local function walkTo(pos, timeout)
    local char, root, hum = getChar()
    if not root or not hum then return false end
    timeout = timeout or 12
    local t0 = tick()
    while tick() - t0 < timeout do
        if not root.Parent then return false end
        if (root.Position - pos).Magnitude <= 6 then return true end
        pcall(function() hum:MoveTo(pos) end)
        task.wait(0.1)
    end
    return false
end

local function showRay(from, to, color)
    if not Config.ShowRay then return end
    local dir = to - from
    local len = dir.Magnitude
    if len < 0.2 then return end
    local mid = from + dir * 0.5
    
    local p = Instance.new("Part")
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.CastShadow, p.Material = false, Enum.Material.Neon
    p.Color = color or Color3.fromRGB(0, 255, 140)
    p.Size = Vector3.new(0.1, 0.1, len)
    p.CFrame = CFrame.lookAt(mid, mid + dir.Unit)
    p.Transparency = 0.5
    p.Parent = workspace
    
    TweenService:Create(p, TweenInfo.new(0.5), {Transparency = 1}):Play()
    Debris:AddItem(p, 0.6)
end

