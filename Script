local shipState = {
    enabled       = false,
    multiplier    = 3,
    method        = "AttributeHook",
    ship          = nil,
    hookInstalled = false,
    lastPos       = nil,
    lastTime      = 0,
    spamRemote    = nil,
    lastSpam      = 0,
}

local function findOwnShip()
    for _, m in Workspace:GetChildren() do
        if m:IsA("Model")
            and m:GetAttribute("PlayerShip") == true
            and m:GetAttribute("ShipOwner") == LocalPlayer.UserId then
            return m
        end
    end
    return nil
end

-- ====== AttributeHook ======
local function installAttributeHook()
    if shipState.hookInstalled then return true end
    if not hookmetamethod then return false end

    local ok = pcall(function()
        local oldIdx
        oldIdx = hookmetamethod(game, "__index", function(self, key)
            local result = oldIdx(self, key)

            if key == "GetAttribute" and typeof(self) == "Instance" then
                return function(inst, attr)
                    if attr == "ShipSpeed"
                        and shipState.enabled
                        and shipState.method ~= "CFrame"
                        and typeof(inst) == "Instance"
                        and inst:IsA("Model")
                        and inst:GetAttribute("ShipOwner") == LocalPlayer.UserId then
                        local real = result(inst, attr)
                        if type(real) == "number" then
                            return real * shipState.multiplier
                        end
                    end
                    return result(inst, attr)
                end
            end
            return result
        end)
    end)

    if ok then
        shipState.hookInstalled = true
        log("Ship: AttributeHook ติดตั้งแล้ว (mult = " .. shipState.multiplier .. ")")
        return true
    end
    return false
end

-- ====== CFrame Override ======
local function applyCFrame(dt)
    local ship = shipState.ship or findOwnShip()
    if not ship then return end
    shipState.ship = ship

    local speed = ship:GetAttribute("ShipSpeed") or 0
    if math.abs(speed) < 0.5 then
        shipState.lastPos = nil
        return
    end

    local now = os.clock()
    if shipState.lastPos and shipState.lastTime > 0 then
        local elapsed = now - shipState.lastTime
        if elapsed > 0 and elapsed < 0.5 then
            local pv   = ship:GetPivot()
            local look = pv.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0.001 then
                flat = flat.Unit
                local boost = speed * (shipState.multiplier - 1) * elapsed
                ship:PivotTo(pv + flat * boost)
                stats.speedFrames += 1
            end
        end
    end
    shipState.lastPos = ship:GetPivot().Position
    shipState.lastTime = now
end

-- ====== Spam remote ======
local function findShipSpamRemote()
    if shipState.spamRemote then return shipState.spamRemote end
    if not RemotesFolder then return nil end
    for _, r in RemotesFolder:GetDescendants() do
        if not (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then continue end
        local l = string.lower(r.Name)
        if string.find(l, "helm") or string.find(l, "shipmove")
            or string.find(l, "shipinput") or string.find(l, "shipcontrol") then
            shipState.spamRemote = r
            return r
        end
    end
    return nil
end

local function applySpam(now)
    if now - shipState.lastSpam < 0.05 then return end
    shipState.lastSpam = now
    local r = findShipSpamRemote()
    if not r then return end
    for _, p in { { helm = { throttle = 1, steer = 0 } },
                  { throttle = 1, steer = 0 },
                  { x = 0, z = 1 } } do
        pcall(function()
            if r:IsA("RemoteEvent") then r:FireServer(p) else r:InvokeServer(p) end
        end)
    end
end

RunService.Heartbeat:Connect(function(dt)
    if not shipState.enabled then return end
    if shipState.method == "CFrame" or shipState.method == "Hybrid" then
        applyCFrame(dt)
    end
    if shipState.method == "Spam" or shipState.method == "Hybrid" then
        applySpam(os.clock())
    end
end)

