-- Hotkey F8 = toggle all on/off
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        local on = not (Config.Harvest or Config.Water or Config.Sell)
        Config.Harvest, Config.Water, Config.Sell = on, on, on
        for _, row in ipairs(root:GetChildren()) do
            if row:IsA("Frame") and row.BackgroundColor3 == Color3.fromRGB(32, 40, 46) then
                local btn = row:FindFirstChildWhichIsA("TextButton")
                if btn then
                    if on then
                        btn.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
                        local t = btn.Text
                        if t:sub(1, 1) ~= "■" then btn.Text = "■ " .. t:sub(3) end
                    else
                        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                        local t = btn.Text
                        if t:sub(1, 1) ~= "▶" then btn.Text = "▶ " .. t:sub(3) end
                    end
                end
            end
        end
    end
end)

