local function inspectRedeemConfig()
    local RS = game:GetService("ReplicatedStorage")
    local SC = RS:FindFirstChild("Shared")
    local C  = SC and SC:FindFirstChild("Config")
    local R  = C and C:FindFirstChild("Redeem")
    if not R or not R:IsA("ModuleScript") then return nil, "ไม่พบ Shared.Config.Redeem" end
    local ok, cfg = pcall(require, R)
    if not ok then return nil, "require ล้มเหลว: " .. tostring(cfg) end
    return cfg, nil
end

local function dumpConfig(cfg, prefix)
    prefix = prefix or ""
    if type(cfg) ~= "table" then return end
    for k, v in pairs(cfg) do
        local line = prefix .. tostring(k) .. " (" .. type(v) .. ")"
        if type(v) == "string" and #v <= 40 then line = line .. " = " .. v
        elseif type(v) == "number" or type(v) == "boolean" then line = line .. " = " .. tostring(v) end
        print(line)
        if type(v) == "table" and prefix:len() < 30 then
            dumpConfig(v, prefix .. tostring(k) .. ".")
        end
    end
end

local function findRedeemRemotes()
    if not RemotesFolder then return {} end
    local found = {}
    for _, r in RemotesFolder:GetDescendants() do
        if not (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then continue end
        local l = string.lower(r.Name)
        if string.find(l, "redeem") or string.find(l, "code") then
            table.insert(found, r)
        end
    end
    return found
end

